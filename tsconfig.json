{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": false,
    "noEmit": true,
    "paths": {
      "stats-kit/contract": ["./packages/contract/src/index.ts"],
      "stats-kit/server": ["./packages/server/src/index.ts"]
    }
  },
  "include": ["packages/contract/src", "packages/contract/test", "packages/server/src", "packages/server/test", "demo/server", "demo/fake", "scripts/examples.ts", "scripts/dotnet-data.ts", "scripts/dotnet-golden.ts", "vitest.config.ts"]
}
