{
  "name": "stats-kit",
  "version": "0.2.6",
  "description": "Website traffic statistics for a site administration: Umami, Google Search Console and YouTube connectors, weekly e-mail report, Angular components, labels in several languages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "packages/contract/dist",
    "packages/contract/schema",
    "packages/server/dist",
    "packages/server/assets",
    "packages/angular/dist",
    "scripts/prepare.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "exports": {
    "./contract": {
      "types": "./packages/contract/dist/index.d.ts",
      "stats-kit-source": "./packages/contract/src/index.ts",
      "default": "./packages/contract/dist/index.js"
    },
    "./contract/schema.json": "./packages/contract/schema/contract.schema.json",
    "./server": {
      "types": "./packages/server/dist/index.d.ts",
      "stats-kit-source": "./packages/server/src/index.ts",
      "default": "./packages/server/dist/index.js"
    },
    "./server/world.json": "./packages/server/assets/world-110m.json",
    "./angular": {
      "types": "./packages/angular/dist/types/stats-kit-angular.d.ts",
      "default": "./packages/angular/dist/fesm2022/stats-kit-angular.mjs"
    },
    "./contrat": {
      "types": "./packages/contract/dist/index.d.ts",
      "stats-kit-source": "./packages/contract/src/index.ts",
      "default": "./packages/contract/dist/index.js"
    },
    "./contrat/schema.json": "./packages/contract/schema/contract.schema.json",
    "./serveur": {
      "types": "./packages/server/dist/index.d.ts",
      "stats-kit-source": "./packages/server/src/index.ts",
      "default": "./packages/server/dist/index.js"
    },
    "./serveur/monde.json": "./packages/server/assets/world-110m.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "build": "npm run build:contract && npm run build:server && npm run build:angular",
    "build:contract": "tsc -p packages/contract/tsconfig.build.json",
    "build:server": "tsc -p packages/server/tsconfig.build.json",
    "build:angular": "ng build stats-kit-angular",
    "schema": "node scripts/schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p demo/tsconfig.app.json --noEmit",
    "test": "vitest run --coverage",
    "test:angular": "ng test stats-kit-angular --watch=false --coverage",
    "demo:build": "ng build demo",
    "demo": "node --conditions=stats-kit-source demo/server/start.ts",
    "e2e": "npm run demo:build && playwright test",
    "screenshots": "node --conditions=stats-kit-source scripts/screenshots.ts",
    "examples": "node --conditions=stats-kit-source scripts/examples.ts",
    "schema:check": "node scripts/schema.mjs --check",
    "release": "node scripts/publish-tag.mjs",
    "dotnet:data": "node --conditions=stats-kit-source scripts/dotnet-data.ts",
    "dotnet:golden": "node --conditions=stats-kit-source scripts/dotnet-golden.ts",
    "dotnet:check": "node --conditions=stats-kit-source scripts/dotnet-data.ts --check && node --conditions=stats-kit-source scripts/dotnet-golden.ts --check"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0",
    "@angular/core": ">=21.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.1",
    "express": "^5.1.0",
    "jsdom": "^31.0.1",
    "ng-packagr": "^22.3.0",
    "rxjs": "~7.8.0",
    "ts-json-schema-generator": "^2.10.0",
    "tslib": "^2.9.1",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  }
}
