{
  "name": "stats-kit",
  "version": "0.1.1",
  "description": "Statistiques de fréquentation pour l'administration d'un site : connecteurs Umami, Google Search Console et YouTube, rapport hebdomadaire par e-mail, composants Angular.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "packages/contrat/dist",
    "packages/contrat/schema",
    "packages/serveur/dist",
    "packages/serveur/assets",
    "packages/angular/dist",
    "scripts/prepare.mjs",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "exports": {
    "./contrat": {
      "types": "./packages/contrat/dist/index.d.ts",
      "stats-kit-source": "./packages/contrat/src/index.ts",
      "default": "./packages/contrat/dist/index.js"
    },
    "./contrat/schema.json": "./packages/contrat/schema/contrat.schema.json",
    "./serveur": {
      "types": "./packages/serveur/dist/index.d.ts",
      "stats-kit-source": "./packages/serveur/src/index.ts",
      "default": "./packages/serveur/dist/index.js"
    },
    "./serveur/monde.json": "./packages/serveur/assets/world-110m.json",
    "./angular": {
      "types": "./packages/angular/dist/types/stats-kit-angular.d.ts",
      "default": "./packages/angular/dist/fesm2022/stats-kit-angular.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {},
  "peerDependencies": {
    "@angular/common": ">=21.0.0",
    "@angular/core": ">=21.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  }
}
