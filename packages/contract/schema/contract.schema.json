{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Contract",
  "definitions": {
    "Contract": {
      "type": "object",
      "properties": {
        "overview": {
          "$ref": "#/definitions/StatsOverview"
        },
        "live": {
          "$ref": "#/definitions/LiveResponse"
        },
        "search": {
          "$ref": "#/definitions/SearchOverview"
        },
        "indexation": {
          "$ref": "#/definitions/IndexationResponse"
        },
        "youtube": {
          "$ref": "#/definitions/YoutubeOverview"
        },
        "reportPreview": {
          "$ref": "#/definitions/ReportPreview"
        },
        "reportSend": {
          "$ref": "#/definitions/ReportSendResult"
        }
      },
      "required": [
        "overview",
        "live",
        "search",
        "indexation",
        "youtube",
        "reportPreview",
        "reportSend"
      ],
      "additionalProperties": false,
      "description": "All the responses (root of the JSON schema)."
    },
    "StatsOverview": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/ContractVersion"
        },
        "status": {
          "$ref": "#/definitions/SourceStatus"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short message when `status` is `error`."
        },
        "generatedAt": {
          "type": "string",
          "description": "Computation instant, UTC."
        },
        "range": {
          "$ref": "#/definitions/Range"
        },
        "totals": {
          "$ref": "#/definitions/Totals"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/definitions/Totals"
            },
            {
              "type": "null"
            }
          ],
          "description": "Totals of the previous period; `null` if unknown."
        },
        "active": {
          "type": [
            "number",
            "null"
          ],
          "description": "Visitors active right now (last 5 minutes); `null` if unknown."
        },
        "series": {
          "$ref": "#/definitions/Series"
        },
        "last24h": {
          "$ref": "#/definitions/Series",
          "description": "Last 24 hours, hour by hour (whatever the chosen period)."
        },
        "heatmap": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "Page views by weekday (Monday = 0) and hour (0 to 23), in the time zone of the period: 7 rows of 24 numbers."
        },
        "breakdowns": {
          "$ref": "#/definitions/Breakdowns"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PageRow"
          },
          "description": "Detail by page; empty if the source does not provide it (the components then fall back to `breakdowns.pages`)."
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemGroup"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Goal"
          }
        },
        "counts": {
          "$ref": "#/definitions/Counts"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Session"
          }
        },
        "extras": {
          "anyOf": [
            {
              "$ref": "#/definitions/Extras"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventSeries": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Occurrences of each tracked event per slot of `series` (same order as `series.slots`), by event name; `null` if the source does not give them. Optional: a server that does not fill it leaves the \"last 7 days\" column of the actions table out."
        },
        "dashboardUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "Address of the source dashboard (Umami), to go further; `null` to hide it."
        }
      },
      "required": [
        "version",
        "status",
        "error",
        "generatedAt",
        "range",
        "totals",
        "previous",
        "active",
        "series",
        "last24h",
        "heatmap",
        "breakdowns",
        "pages",
        "groups",
        "goals",
        "counts",
        "sessions",
        "extras",
        "dashboardUrl"
      ],
      "additionalProperties": false,
      "description": "Response of `GET {base}/overview`: everything the Statistics page shows."
    },
    "ContractVersion": {
      "type": "number",
      "const": 1,
      "description": "Contract version; it changes with every incompatible change."
    },
    "SourceStatus": {
      "type": "string",
      "enum": [
        "ok",
        "not-configured",
        "error"
      ],
      "description": "State of a source: `ok`, `not-configured` (no settings: nothing is called) or `error` (the source did not answer)."
    },
    "Range": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "description": "Start (included), UTC instant."
        },
        "to": {
          "type": "string",
          "description": "End (excluded), UTC instant."
        },
        "days": {
          "type": "number",
          "description": "Number of days covered (1 for the last 24 hours)."
        },
        "unit": {
          "$ref": "#/definitions/Unit",
          "description": "Granularity of the main series: `hour` for 24 hours, `day` beyond."
        },
        "timeZone": {
          "type": "string",
          "description": "IANA time zone of the slots (\"Europe/Paris\")."
        },
        "previousFrom": {
          "type": "string",
          "description": "Start of the previous period, UTC instant."
        },
        "previousTo": {
          "type": "string",
          "description": "End of the previous period (= start of the period), UTC instant."
        }
      },
      "required": [
        "from",
        "to",
        "days",
        "unit",
        "timeZone",
        "previousFrom",
        "previousTo"
      ],
      "additionalProperties": false,
      "description": "Period shown and previous period of the same length."
    },
    "Unit": {
      "type": "string",
      "enum": [
        "day",
        "hour"
      ],
      "description": "Granularity of a series: one point per day or per hour."
    },
    "Totals": {
      "type": "object",
      "properties": {
        "pageviews": {
          "type": "number",
          "description": "Page views."
        },
        "visitors": {
          "type": "number",
          "description": "Distinct visitors."
        },
        "visits": {
          "type": "number",
          "description": "Visits (sessions)."
        },
        "bounces": {
          "type": "number",
          "description": "Single-page visits."
        },
        "totaltime": {
          "type": "number",
          "description": "Cumulated time spent, in seconds."
        }
      },
      "required": [
        "pageviews",
        "visitors",
        "visits",
        "bounces",
        "totaltime"
      ],
      "additionalProperties": false,
      "description": "Totals of a period."
    },
    "Series": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/definitions/Unit"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Slots in the time zone of the period: \"YYYY-MM-DD\" (day) or \"YYYY-MM-DDTHH\" (hour)."
        },
        "pageviews": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Page views, one value per slot."
        },
        "visitors": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Visitors (Umami sessions), one value per slot."
        },
        "previousPageviews": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Page views of the previous period, aligned slot by slot; `null` if unknown."
        }
      },
      "required": [
        "unit",
        "slots",
        "pageviews",
        "visitors",
        "previousPageviews"
      ],
      "additionalProperties": false,
      "description": "Continuous time series: one slot per day or hour of the period, even without data (zero)."
    },
    "Breakdowns": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Page views by logical path."
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Entry pages (visits)."
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Exit pages (visits)."
        },
        "referrers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Sites the visits come from (domain; empty key = direct access)."
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Umami acquisition channels (direct, organicSearch…)."
        },
        "countries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Countries (ISO code)."
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Regions (\"FR-PAC\")."
        },
        "cities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Browser language of the visitors (code)."
        },
        "siteLanguages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Site language viewed (path prefix), if the site is multilingual."
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Devices (desktop, laptop, mobile, tablet)."
        },
        "browsers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "os": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "screens": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Screen sizes (\"390x844\")."
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Tracked events (name)."
        },
        "hostnames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Addresses (host names) visited."
        },
        "utmSources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "utmMediums": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "utmCampaigns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        }
      },
      "required": [
        "pages",
        "entries",
        "exits",
        "referrers",
        "channels",
        "countries",
        "regions",
        "cities",
        "languages",
        "siteLanguages",
        "devices",
        "browsers",
        "os",
        "screens",
        "events",
        "hostnames",
        "utmSources",
        "utmMediums",
        "utmCampaigns"
      ],
      "additionalProperties": false,
      "description": "Rankings of a period. Each list is sorted by decreasing value."
    },
    "Item": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Raw value returned by the source: path, ISO country code, language code, event name…"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Readable label given by the server (site settings); otherwise the components compute one from `key`."
        },
        "value": {
          "type": "number",
          "description": "Number (visits, views or occurrences depending on the ranking)."
        },
        "previous": {
          "type": [
            "number",
            "null"
          ],
          "description": "Same number over the previous period; `null` if the source does not provide it."
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "previous"
      ],
      "additionalProperties": false,
      "description": "Row of a ranking (page, country, source…)."
    },
    "PageRow": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Logical path (\"/contact\")."
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "type": "number"
        },
        "visitors": {
          "type": "number"
        },
        "entries": {
          "type": "number",
          "description": "Visits that started on this page."
        },
        "exits": {
          "type": "number",
          "description": "Visits that ended on this page."
        },
        "bounces": {
          "type": "number",
          "description": "Single-page visits that started here."
        },
        "totaltime": {
          "type": "number",
          "description": "Cumulated time spent on the page, in seconds."
        },
        "previousViews": {
          "type": [
            "number",
            "null"
          ],
          "description": "Views of the previous period; `null` if unknown."
        }
      },
      "required": [
        "key",
        "label",
        "views",
        "visitors",
        "entries",
        "exits",
        "bounces",
        "totaltime",
        "previousViews"
      ],
      "additionalProperties": false,
      "description": "Detail of a page (all languages together if the site groups its paths)."
    },
    "ItemGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        }
      },
      "required": [
        "id",
        "title",
        "items"
      ],
      "additionalProperties": false,
      "description": "Group of pages defined by the site (product pages, articles…)."
    },
    "Goal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "previous": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "previous"
      ],
      "additionalProperties": false,
      "description": "Goal of the site: total of one or more tracked events (click to call, form sent…)."
    },
    "Counts": {
      "type": "object",
      "properties": {
        "countries": {
          "type": [
            "number",
            "null"
          ]
        },
        "events": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "countries",
        "events"
      ],
      "additionalProperties": false,
      "description": "Number of distinct dimensions over the period (`null` if the source does not give it)."
    },
    "Session": {
      "type": "object",
      "properties": {
        "country": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 3166-1 alpha-2 country code."
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "browser": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "type": "number"
        },
        "lastAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "Last activity, UTC instant."
        }
      },
      "required": [
        "country",
        "city",
        "device",
        "browser",
        "os",
        "views",
        "lastAt"
      ],
      "additionalProperties": false,
      "description": "Recent visit, without identifying the person."
    },
    "Extras": {
      "type": "object",
      "properties": {
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExtraTile"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExtraTable"
          }
        },
        "funnel": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Last step of the funnel (\"Requests received\"); `null` without a step."
        }
      },
      "required": [
        "tiles",
        "tables",
        "funnel"
      ],
      "additionalProperties": false,
      "description": "Site's own data, shown with the sources' data (shown even if Umami does not answer)."
    },
    "ExtraTile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ],
          "description": "Number, or text already formatted."
        },
        "previous": {
          "type": [
            "number",
            "null"
          ]
        },
        "sub": {
          "type": [
            "string",
            "null"
          ],
          "description": "Context under the figure."
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "description": "Title of the tile group; `null`: the site data group."
        },
        "highlight": {
          "type": "boolean",
          "description": "Highlighted (to handle, pending…)."
        },
        "link": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "label"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Where to act on it (the site's list of requests…): a link under the figure in the page and, for a highlighted tile, at the end of its line in the report. Optional; `null` or missing: no link."
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "previous",
        "sub",
        "group",
        "highlight"
      ],
      "additionalProperties": false,
      "description": "Figure tile added by the site (data from its own database: requests received, orders…)."
    },
    "ExtraTable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sub": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": "string",
          "description": "Title of the label column."
        },
        "column": {
          "type": "string",
          "description": "Title of the number column."
        },
        "section": {
          "$ref": "#/definitions/Section"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        }
      },
      "required": [
        "id",
        "title",
        "sub",
        "head",
        "column",
        "section",
        "items"
      ],
      "additionalProperties": false,
      "description": "Table added by the site."
    },
    "Section": {
      "type": "string",
      "enum": [
        "pages",
        "sources",
        "audience",
        "actions"
      ],
      "description": "Section of the Statistics page where a table goes."
    },
    "LiveResponse": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/ContractVersion"
        },
        "active": {
          "type": [
            "number",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "active",
        "at"
      ],
      "additionalProperties": false,
      "description": "Response of `GET {base}/live`: active visitors."
    },
    "SearchOverview": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/ContractVersion"
        },
        "status": {
          "$ref": "#/definitions/SourceStatus"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatedAt": {
          "type": "string"
        },
        "property": {
          "type": [
            "string",
            "null"
          ],
          "description": "Search Console property (\"sc-domain:example.org\")."
        },
        "serviceAccount": {
          "type": [
            "string",
            "null"
          ],
          "description": "Address of the service account to add as a user of the property; `null` with OAuth or without settings."
        },
        "start": {
          "type": "string",
          "description": "Period (days included): Google publishes two to three days late, so it ends before today."
        },
        "end": {
          "type": "string"
        },
        "days": {
          "type": "number"
        },
        "previousStart": {
          "type": "string"
        },
        "previousEnd": {
          "type": "string"
        },
        "totals": {
          "$ref": "#/definitions/SearchTotals"
        },
        "previous": {
          "$ref": "#/definitions/SearchTotals"
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchDay"
          }
        },
        "previousSeries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchDay"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "previousQueries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "previousPages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "countries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "previousCountries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "devices": {
