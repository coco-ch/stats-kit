{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Contract",
  "definitions": {
    "Contract": {
      "type": "object",
      "properties": {
        "overview": {
          "$ref": "#/definitions/StatsOverview"
        },
        "live": {
          "$ref": "#/definitions/LiveResponse"
        },
        "search": {
          "$ref": "#/definitions/SearchOverview"
        },
        "indexation": {
          "$ref": "#/definitions/IndexationResponse"
        },
        "youtube": {
          "$ref": "#/definitions/YoutubeOverview"
        },
        "reportPreview": {
          "$ref": "#/definitions/ReportPreview"
        },
        "reportSend": {
          "$ref": "#/definitions/ReportSendResult"
        }
      },
      "required": [
        "overview",
        "live",
        "search",
        "indexation",
        "youtube",
        "reportPreview",
        "reportSend"
      ],
      "additionalProperties": false,
      "description": "Ensemble des réponses (racine du schéma JSON)."
    },
    "StatsOverview": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/ContractVersion"
        },
        "status": {
          "$ref": "#/definitions/SourceStatus"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Message court quand `status` vaut `error`."
        },
        "generatedAt": {
          "type": "string",
          "description": "Instant de calcul, UTC."
        },
        "range": {
          "$ref": "#/definitions/Range"
        },
        "totals": {
          "$ref": "#/definitions/Totals"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/definitions/Totals"
            },
            {
              "type": "null"
            }
          ],
          "description": "Totaux de la période précédente ; `null` si inconnus."
        },
        "active": {
          "type": [
            "number",
            "null"
          ],
          "description": "Visiteurs actifs à l'instant (5 dernières minutes) ; `null` si inconnu."
        },
        "series": {
          "$ref": "#/definitions/Series"
        },
        "last24h": {
          "$ref": "#/definitions/Series",
          "description": "Dernières 24 heures, heure par heure (indépendant de la période choisie)."
        },
        "heatmap": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "description": "Pages vues par jour de la semaine (lundi = 0) et par heure (0 à 23), dans le fuseau de la période : 7 lignes de 24 nombres."
        },
        "breakdowns": {
          "$ref": "#/definitions/Breakdowns"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PageRow"
          },
          "description": "Détail par page ; vide si la source ne le fournit pas (les composants se rabattent alors sur `breakdowns.pages`)."
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemGroup"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Goal"
          }
        },
        "counts": {
          "$ref": "#/definitions/Counts"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Session"
          }
        },
        "extras": {
          "anyOf": [
            {
              "$ref": "#/definitions/Extras"
            },
            {
              "type": "null"
            }
          ]
        },
        "dashboardUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "Adresse du tableau de bord de la source (Umami), pour aller plus loin ; `null` pour ne pas l'afficher."
        }
      },
      "required": [
        "version",
        "status",
        "error",
        "generatedAt",
        "range",
        "totals",
        "previous",
        "active",
        "series",
        "last24h",
        "heatmap",
        "breakdowns",
        "pages",
        "groups",
        "goals",
        "counts",
        "sessions",
        "extras",
        "dashboardUrl"
      ],
      "additionalProperties": false,
      "description": "Réponse de `GET {base}/overview` : tout ce qu'affiche la page Statistiques."
    },
    "ContractVersion": {
      "type": "number",
      "const": 1,
      "description": "Version du contrat ; elle change à chaque modification incompatible."
    },
    "SourceStatus": {
      "type": "string",
      "enum": [
        "ok",
        "not-configured",
        "error"
      ],
      "description": "État d'une source : `ok`, `not-configured` (réglages absents : rien n'est appelé) ou `error` (la source n'a pas répondu)."
    },
    "Range": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "description": "Début (inclus), instant UTC."
        },
        "to": {
          "type": "string",
          "description": "Fin (exclue), instant UTC."
        },
        "days": {
          "type": "number",
          "description": "Nombre de jours couverts (1 pour les dernières 24 heures)."
        },
        "unit": {
          "$ref": "#/definitions/Unit",
          "description": "Granularité de la série principale : `hour` pour 24 heures, `day` au-delà."
        },
        "timeZone": {
          "type": "string",
          "description": "Fuseau IANA dans lequel sont exprimés les créneaux (« Europe/Paris »)."
        },
        "previousFrom": {
          "type": "string",
          "description": "Début de la période précédente, instant UTC."
        },
        "previousTo": {
          "type": "string",
          "description": "Fin de la période précédente (= début de la période), instant UTC."
        }
      },
      "required": [
        "from",
        "to",
        "days",
        "unit",
        "timeZone",
        "previousFrom",
        "previousTo"
      ],
      "additionalProperties": false,
      "description": "Période affichée et période précédente de même durée."
    },
    "Unit": {
      "type": "string",
      "enum": [
        "day",
        "hour"
      ],
      "description": "Granularité d'une série : un point par jour ou par heure."
    },
    "Totals": {
      "type": "object",
      "properties": {
        "pageviews": {
          "type": "number",
          "description": "Pages vues."
        },
        "visitors": {
          "type": "number",
          "description": "Visiteurs distincts."
        },
        "visits": {
          "type": "number",
          "description": "Visites (sessions)."
        },
        "bounces": {
          "type": "number",
          "description": "Visites d'une seule page."
        },
        "totaltime": {
          "type": "number",
          "description": "Temps passé cumulé, en secondes."
        }
      },
      "required": [
        "pageviews",
        "visitors",
        "visits",
        "bounces",
        "totaltime"
      ],
      "additionalProperties": false,
      "description": "Totaux d'une période."
    },
    "Series": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/definitions/Unit"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Créneaux dans le fuseau de la période : « AAAA-MM-JJ » (jour) ou « AAAA-MM-JJTHH » (heure)."
        },
        "pageviews": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Pages vues, une valeur par créneau."
        },
        "visitors": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Visiteurs (sessions Umami), une valeur par créneau."
        },
        "previousPageviews": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Pages vues de la période précédente, alignées créneau par créneau ; `null` si inconnues."
        }
      },
      "required": [
        "unit",
        "slots",
        "pageviews",
        "visitors",
        "previousPageviews"
      ],
      "additionalProperties": false,
      "description": "Série temporelle continue : un créneau par jour ou par heure de la période, même sans donnée (zéro)."
    },
    "Breakdowns": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Pages vues par chemin logique."
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Pages d'entrée (visites)."
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Pages de sortie (visites)."
        },
        "referrers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Sites d'où viennent les visites (domaine ; clé vide = accès direct)."
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Canaux d'acquisition Umami (direct, organicSearch…)."
        },
        "countries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Pays (code ISO)."
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Régions (« FR-PAC »)."
        },
        "cities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Langue du navigateur des visiteurs (code)."
        },
        "siteLanguages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Langue du site consultée (préfixe de chemin), si le site est multilingue."
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Appareils (desktop, laptop, mobile, tablet)."
        },
        "browsers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "os": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "screens": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Tailles d'écran (« 390x844 »)."
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Événements suivis (nom)."
        },
        "hostnames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          },
          "description": "Adresses (nom d'hôte) consultées."
        },
        "utmSources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "utmMediums": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "utmCampaigns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        }
      },
      "required": [
        "pages",
        "entries",
        "exits",
        "referrers",
        "channels",
        "countries",
        "regions",
        "cities",
        "languages",
        "siteLanguages",
        "devices",
        "browsers",
        "os",
        "screens",
        "events",
        "hostnames",
        "utmSources",
        "utmMediums",
        "utmCampaigns"
      ],
      "additionalProperties": false,
      "description": "Classements d'une période. Chaque liste est triée par valeur décroissante."
    },
    "Item": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Valeur brute renvoyée par la source : chemin, code pays ISO, code langue, nom d'événement…"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Libellé lisible fourni par le serveur (réglages du site) ; sinon les composants en calculent un à partir de `key`."
        },
        "value": {
          "type": "number",
          "description": "Nombre (visites, vues ou occurrences selon le classement)."
        },
        "previous": {
          "type": [
            "number",
            "null"
          ],
          "description": "Même nombre sur la période précédente ; `null` si la source ne le fournit pas."
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "previous"
      ],
      "additionalProperties": false,
      "description": "Ligne d'un classement (page, pays, source…)."
    },
    "PageRow": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Chemin logique (« /contact »)."
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "type": "number"
        },
        "visitors": {
          "type": "number"
        },
        "entries": {
          "type": "number",
          "description": "Visites commencées sur cette page."
        },
        "exits": {
          "type": "number",
          "description": "Visites terminées sur cette page."
        },
        "bounces": {
          "type": "number",
          "description": "Visites d'une seule page commencées ici."
        },
        "totaltime": {
          "type": "number",
          "description": "Temps passé cumulé sur la page, en secondes."
        },
        "previousViews": {
          "type": [
            "number",
            "null"
          ],
          "description": "Vues de la période précédente ; `null` si inconnues."
        }
      },
      "required": [
        "key",
        "label",
        "views",
        "visitors",
        "entries",
        "exits",
        "bounces",
        "totaltime",
        "previousViews"
      ],
      "additionalProperties": false,
      "description": "Détail d'une page (toutes langues réunies si le site regroupe ses chemins)."
    },
    "ItemGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        }
      },
      "required": [
        "id",
        "title",
        "items"
      ],
      "additionalProperties": false,
      "description": "Regroupement de pages défini par le site (fiches produit, articles…)."
    },
    "Goal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "previous": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "previous"
      ],
      "additionalProperties": false,
      "description": "Objectif du site : total d'un ou plusieurs événements suivis (clic pour appeler, formulaire envoyé…)."
    },
    "Counts": {
      "type": "object",
      "properties": {
        "countries": {
          "type": [
            "number",
            "null"
          ]
        },
        "events": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "countries",
        "events"
      ],
      "additionalProperties": false,
      "description": "Nombre de dimensions distinctes sur la période (`null` si la source ne le donne pas)."
    },
    "Session": {
      "type": "object",
      "properties": {
        "country": {
          "type": [
            "string",
            "null"
          ],
          "description": "Code pays ISO 3166-1 alpha-2."
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "browser": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "type": "number"
        },
        "lastAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "Dernière activité, instant UTC."
        }
      },
      "required": [
        "country",
        "city",
        "device",
        "browser",
        "os",
        "views",
        "lastAt"
      ],
      "additionalProperties": false,
      "description": "Visite récente, sans identification de la personne."
    },
    "Extras": {
      "type": "object",
      "properties": {
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExtraTile"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExtraTable"
          }
        },
        "funnel": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Dernière étape de l'entonnoir (« Demandes reçues ») ; `null` sans étape."
        }
      },
      "required": [
        "tiles",
        "tables",
        "funnel"
      ],
      "additionalProperties": false,
      "description": "Données propres au site, affichées avec celles des sources (elles s'affichent même si Umami ne répond pas)."
    },
    "ExtraTile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ],
          "description": "Nombre, ou texte déjà mis en forme."
        },
        "previous": {
          "type": [
            "number",
            "null"
          ]
        },
        "sub": {
          "type": [
            "string",
            "null"
          ],
          "description": "Contexte sous le chiffre."
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "description": "Titre du groupe de tuiles ; `null` : groupe des données du site."
        },
        "highlight": {
          "type": "boolean",
          "description": "Mise en avant (à traiter, en attente…)."
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "previous",
        "sub",
        "group",
        "highlight"
      ],
      "additionalProperties": false,
      "description": "Tuile chiffrée ajoutée par le site (données de sa propre base : demandes reçues, commandes…)."
    },
    "ExtraTable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sub": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": "string",
          "description": "Titre de la colonne des libellés."
        },
        "column": {
          "type": "string",
          "description": "Titre de la colonne des nombres."
        },
        "section": {
          "$ref": "#/definitions/Section"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        }
      },
      "required": [
        "id",
        "title",
        "sub",
        "head",
        "column",
        "section",
        "items"
      ],
      "additionalProperties": false,
      "description": "Tableau ajouté par le site."
    },
    "Section": {
      "type": "string",
      "enum": [
        "pages",
        "sources",
        "audience",
        "actions"
      ],
      "description": "Section de la page Statistiques où ranger un tableau."
    },
    "LiveResponse": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/ContractVersion"
        },
        "active": {
          "type": [
            "number",
            "null"
          ]
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "active",
        "at"
      ],
      "additionalProperties": false,
      "description": "Réponse de `GET {base}/live` : visiteurs actifs."
    },
    "SearchOverview": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/ContractVersion"
        },
        "status": {
          "$ref": "#/definitions/SourceStatus"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatedAt": {
          "type": "string"
        },
        "property": {
          "type": [
            "string",
            "null"
          ],
          "description": "Propriété Search Console (« sc-domain:exemple.org »)."
        },
        "serviceAccount": {
          "type": [
            "string",
            "null"
          ],
          "description": "Adresse du compte de service à ajouter comme utilisateur de la propriété ; `null` en mode OAuth ou sans réglage."
        },
        "start": {
          "type": "string",
          "description": "Période (jours inclus) : Google publie avec deux à trois jours de retard, elle s'arrête donc avant aujourd'hui."
        },
        "end": {
          "type": "string"
        },
        "days": {
          "type": "number"
        },
        "previousStart": {
          "type": "string"
        },
        "previousEnd": {
          "type": "string"
        },
        "totals": {
          "$ref": "#/definitions/SearchTotals"
        },
        "previous": {
          "$ref": "#/definitions/SearchTotals"
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchDay"
          }
        },
        "previousSeries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchDay"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "previousQueries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
        "previousPages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchRow"
          }
        },
